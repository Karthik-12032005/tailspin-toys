---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters">
      <h2 class="text-xl font-semibold text-slate-100">Filter games</h2>
      <form id="game-filter-form" class="mt-4 grid gap-4 md:grid-cols-[1fr_1fr_auto_auto] md:items-end" data-testid="filter-form">
        <div>
          <label for="category-filter" class="mb-2 block text-sm font-medium text-slate-200">Categories</label>
          <select
            id="category-filter"
            name="category"
            multiple
            size={Math.min(Math.max(categories.length, 2), 5)}
            class="min-h-24 w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="category-filter"
          >
            {categories.map((category) => <option value={category.id}>{category.name}</option>)}
          </select>
          <p class="mt-1 text-xs text-slate-400">Choose one or more categories.</p>
        </div>

        <div>
          <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Publisher</label>
          <select
            id="publisher-filter"
            name="publisher"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="publisher-filter"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
          </select>
        </div>

        <button
          type="submit"
          class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
          data-testid="apply-filters"
        >
          Apply filters
        </button>
        <button
          type="button"
          class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
          data-testid="clear-filters"
        >
          Clear
        </button>
      </form>
    </div>

    <div>
      <div class="mb-6 flex items-center justify-between gap-4">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        <p class="text-sm text-slate-400" data-testid="filter-result-count" aria-live="polite"></p>
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      <div class="hidden" data-testid="filtered-empty-state">
        <EmptyState text="No games match the selected filters." />
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('#game-filter-form');
  const categoryFilter = document.querySelector<HTMLSelectElement>('#category-filter');
  const publisherFilter = document.querySelector<HTMLSelectElement>('#publisher-filter');
  const clearButton = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

  const updateFilters = (categories: string[], publisher: string) => {
    if (!gamesGrid || !resultCount || !emptyState) return;

    let visibleCount = 0;
    gamesGrid.querySelectorAll<HTMLElement>('[data-testid="game-card"]').forEach((card) => {
      const matchesCategory =
        categories.length === 0 || categories.includes(card.dataset.categoryId ?? '');
      const matchesPublisher =
        publisher === '' || card.dataset.publisherId === publisher;
      const visible = matchesCategory && matchesPublisher;
      card.classList.toggle('hidden', !visible);
      if (visible) visibleCount += 1;
    });

    emptyState.classList.toggle('hidden', visibleCount !== 0);
    resultCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'game' : 'games'} shown`;
  };

  const readUrlFilters = () => {
    const params = new URLSearchParams(window.location.search);
    const categories = params.getAll('category');
    const publisher = params.get('publisher') ?? '';

    if (categoryFilter) {
      Array.from(categoryFilter.options).forEach((option) => {
        option.selected = categories.includes(option.value);
      });
    }
    if (publisherFilter) publisherFilter.value = publisher;
    updateFilters(categories, publisher);
  };

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const categories = categoryFilter
      ? Array.from(categoryFilter.selectedOptions).map((option) => option.value)
      : [];
    const publisher = publisherFilter?.value ?? '';
    const params = new URLSearchParams();
    categories.forEach((category) => params.append('category', category));
    if (publisher) params.set('publisher', publisher);
    const query = params.toString();
    window.history.replaceState({}, '', query ? `${window.location.pathname}?${query}` : window.location.pathname);
    updateFilters(categories, publisher);
  });

  clearButton?.addEventListener('click', () => {
    if (categoryFilter) Array.from(categoryFilter.options).forEach((option) => { option.selected = false; });
    if (publisherFilter) publisherFilter.value = '';
    window.history.replaceState({}, '', window.location.pathname);
    updateFilters([], '');
  });

  readUrlFilters();
</script>
